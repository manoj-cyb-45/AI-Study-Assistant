# Copy this file to .env and fill in real values. Never commit .env itself.

# ---------------------------------------------------------------------------
# Telegram (required)
# ---------------------------------------------------------------------------
# Get this from @BotFather on Telegram after creating a bot with /newbot
TELEGRAM_BOT_TOKEN=

# Set to true only in production, behind HTTPS (e.g. on Render).
TELEGRAM_USE_WEBHOOK=false
# Public base URL of this deployment, e.g. https://your-app.onrender.com
# The app appends /telegram/webhook automatically.
TELEGRAM_WEBHOOK_URL=
# Random secret string; Telegram echoes it back on every webhook call so you
# can verify requests actually came from Telegram. Generate with e.g.
# `python -c "import secrets; print(secrets.token_hex(32))"`
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# OpenRouter (required)
# ---------------------------------------------------------------------------
# Get this from https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any model slug supported by OpenRouter, e.g. openai/gpt-4o-mini,
# anthropic/claude-3.5-haiku, google/gemini-2.0-flash-001
DEFAULT_LLM_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=1500
LLM_REQUEST_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# GitHub (required) — the repository holding your study material PDFs
# ---------------------------------------------------------------------------
GITHUB_REPO_URL=
GITHUB_BRANCH=main
# Only needed for private repositories. Create a fine-grained PAT with
# read-only "Contents" access.
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Admin commands & scheduled sync
# ---------------------------------------------------------------------------
# Comma-separated Telegram user IDs allowed to run /sync, /syncstatus,
# /reindex, and /status. Find your numeric ID via @userinfobot on Telegram.
ADMIN_USER_IDS=
# Minutes between automatic background syncs. 0 (default) disables the
# scheduler — startup sync and /refresh /sync still work either way.
SYNC_INTERVAL_MINUTES=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
DATABASE_PATH=data/study_assistant.db
UPLOAD_DIR=data/repo
CACHE_DIR=data/cache
LOG_DIR=data/logs
BACKUP_DIR=data/backups

# ---------------------------------------------------------------------------
# Application behaviour
# ---------------------------------------------------------------------------
MAX_CONVERSATION_HISTORY=20
SEARCH_RESULT_LIMIT=8
SEARCH_CONTEXT_CHAR_LIMIT=12000
SESSION_IDLE_TIMEOUT_MINUTES=60
REQUEST_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# FastAPI server
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
